# Hosted API runtime
HOST=0.0.0.0
PORT=3001
HUDDLECANVAS_DATA_FILE=.data/huddlecanvas.json
HUDDLECANVAS_SESSION_SECRET=replace-with-at-least-24-random-characters
HUDDLECANVAS_PERSISTENCE=file

# Hosted PostgreSQL. Set persistence to postgresql and supply a connection URL.
# DATABASE_URL=postgresql://user:password@host:5432/huddlecanvas
HUDDLECANVAS_RUN_MIGRATIONS=true

# Browser OIDC sign-in. Configure all four together in staging/production.
# The callback registered with the provider is:
#   ${HUDDLECANVAS_PUBLIC_ORIGIN}/api/v1/auth/callback
# HUDDLECANVAS_OIDC_ISSUER=https://identity.example.com
# HUDDLECANVAS_OIDC_CLIENT_ID=huddlecanvas-staging
# HUDDLECANVAS_OIDC_CLIENT_SECRET=replace-with-provider-secret
# HUDDLECANVAS_PUBLIC_ORIGIN=https://huddlecanvas-staging.example.com
# HUDDLECANVAS_OIDC_CALLBACK_PATH=/api/v1/auth/callback

# Optional external API bearer-token verification. Configure both together;
# HUDDLECANVAS_OIDC_ISSUER above is also required.
# HUDDLECANVAS_OIDC_AUDIENCE=huddlecanvas-api
# HUDDLECANVAS_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json

# Production API serves this Vite build so browser sessions remain same-origin.
# Relative overrides resolve from the API process working directory.
# HUDDLECANVAS_WEB_DIST=../web/dist

# Local alpha only. Leave false in production.
HUDDLECANVAS_ALLOW_DEV_AUTH=true
HUDDLECANVAS_LOGGER=true
